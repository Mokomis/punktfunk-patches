diff --git a/crates/codec/pyrowave-sys/vendor/pyrowave/shaders/build_idwt_a829.py b/crates/codec/pyrowave-sys/vendor/pyrowave/shaders/build_idwt_a829.py
new file mode 100644
--- /dev/null
+++ b/crates/codec/pyrowave-sys/vendor/pyrowave/shaders/build_idwt_a829.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Build the A829 reconstruction variant without changing the default shader bank."""
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+here = Path(__file__).resolve().parent
+with tempfile.TemporaryDirectory(prefix="idwt-a829-") as scratch:
+    scratch = Path(scratch)
+    source = scratch / "idwt.comp"
+    source.write_text((here / "idwt.comp").read_text().replace(
+        "#version 450", "#version 450\n#extension GL_GOOGLE_include_directive : require"))
+    raw, optimized = scratch / "raw.spv", scratch / "optimized.spv"
+    subprocess.run(["glslangValidator", "-V", "--target-env", "vulkan1.1", "-S", "comp",
+                    "-DFP16=1", "-DPRECISION=1", "-DIDWT_PACKED_SHARED=1",
+                    "-DIDWT_APRON_WIDTH=8", "-I" + str(here), str(source), "-o", str(raw)], check=True)
+    subprocess.run(["spirv-opt", "-O", "--strip-debug", str(raw), "-o", str(optimized)], check=True)
+    subprocess.run(["spirv-val", "--target-env", "vulkan1.1", str(optimized)], check=True)
+    blob = optimized.read_bytes()
+    words = struct.unpack("<" + "I" * (len(blob) // 4), blob)
+    lines = ["// Generated by build_idwt_a829.py; do not edit.", "#pragma once", "#include <stdint.h>",
+             "namespace PyroWave {", "static const uint32_t idwt_a829_spirv[] = {"]
+    for i in range(0, len(words), 8):
+        lines.append("    " + ", ".join(f"0x{v:08x}u" for v in words[i:i + 8]) + ",")
+    lines.extend(["};", "}"])
+    (here / "idwt_a829.hpp").write_text("\n".join(lines) + "\n")
