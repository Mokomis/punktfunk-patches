+/// Keep AdrenoTools and its Vulkan namespace live for the process.
+/// Driver selection is diagnostic and takes effect after restarting the app.
+fn load_entry() -> Result<ash::Entry> {
+    if crate::sys::sysprop(c"debug.punktfunk.vulkan_driver").as_deref() != Some("turnip") {
+        // SAFETY: Entry owns the system loader until its Vulkan objects are destroyed.
+        return unsafe { ash::Entry::load() }.map_err(|e| anyhow!("load system Vulkan: {e}"));
+    }
+    static TURNIP: std::sync::OnceLock<std::result::Result<ash::StaticFn, String>> =
+        std::sync::OnceLock::new();
+    let functions = TURNIP.get_or_init(|| {
+        (|| -> Result<ash::StaticFn> {
+            let maps = std::fs::read_to_string("/proc/self/maps")?;
+            let library = maps.lines()
+                .filter_map(|line| line.split_whitespace().last())
+                .find(|path| path.ends_with("/libpunktfunk_android.so"))
+                .ok_or_else(|| anyhow!("find extracted Android native library directory"))?;
+            let directory = std::path::Path::new(library).parent()
+                .ok_or_else(|| anyhow!("native library directory"))?;
+            let tools = CString::new(directory.join("libadrenotools.so").to_string_lossy().as_bytes())?;
+            let directory = CString::new(format!("{}/", directory.display()))?;
+            type Open = unsafe extern "C" fn(i32, i32, *const libc::c_char,
+                *const libc::c_char, *const libc::c_char, *const libc::c_char,
+                *const libc::c_char, *mut *mut libc::c_void) -> *mut libc::c_void;
+            // SAFETY: bundled libraries are in the app's extracted native directory. Both
+            // handles stay open for the process, outliving every Entry and Vulkan object.
+            unsafe {
+                let handle = libc::dlopen(tools.as_ptr(), libc::RTLD_NOW | libc::RTLD_LOCAL);
+                if handle.is_null() { bail!("load bundled AdrenoTools"); }
+                let symbol = libc::dlsym(handle, c"adrenotools_open_libvulkan".as_ptr());
+                if symbol.is_null() { bail!("resolve AdrenoTools Vulkan entry point"); }
+                let open: Open = std::mem::transmute(symbol);
+                let loader = open(libc::RTLD_NOW | libc::RTLD_LOCAL, 1, std::ptr::null(),
+                    directory.as_ptr(), directory.as_ptr(), c"libvulkan_freedreno.so".as_ptr(),
+                    std::ptr::null(), std::ptr::null_mut());
+                if loader.is_null() { bail!("open bundled Turnip Vulkan loader"); }
+                let symbol = libc::dlsym(loader, c"vkGetInstanceProcAddr".as_ptr());
+                if symbol.is_null() { bail!("resolve Turnip vkGetInstanceProcAddr"); }
+                Ok(ash::StaticFn { get_instance_proc_addr: std::mem::transmute(symbol) })
+            }
+        })().map_err(|error| error.to_string())
+    });
+    match functions {
+        // SAFETY: the process-owned loader and function pointer outlive the Entry.
+        Ok(functions) => Ok(unsafe { ash::Entry::from_static_fn(functions.clone()) }),
+        Err(error) => bail!("load Turnip: {error}"),
+    }
