+/// Timestamps around the colour-conversion draw: two queries per frame slot, read back when
+/// the slot's fence has been waited on.
+struct DrawTimer {
+    pool: vk::QueryPool,
+    /// Nanoseconds per timestamp tick.
+    period_ns: f64,
+    /// The slot's queries were written by a submit and not yet read.
+    written: [bool; FRAMES],
+    sum_ns: f64,
+    max_ns: f64,
+    n: u32,
+}
+
+impl DrawTimer {
+    /// Read `frame`'s pair, whose submit has completed, and log every [`DRAW_STATS_EVERY`].
+    fn collect(&mut self, device: &ash::Device, frame: usize) {
+        if !std::mem::take(&mut self.written[frame]) {
+            return;
+        }
+        let mut ticks = [0u64; 2];
+        // SAFETY: the pool is owned here; the two queries were written by a submit whose
+        // fence the caller has waited on.
+        let read = unsafe {
+            device.get_query_pool_results(
+                self.pool,
+                2 * frame as u32,
+                &mut ticks,
+                vk::QueryResultFlags::TYPE_64,
+            )
+        };
+        if read.is_err() {
+            return;
+        }
+        let ns = ticks[1].saturating_sub(ticks[0]) as f64 * self.period_ns;
+        self.sum_ns += ns;
+        self.max_ns = self.max_ns.max(ns);
+        self.n += 1;
+        if self.n >= DRAW_STATS_EVERY {
+            log::info!(
+                "pyro: present draw GPU time avg={:.3} ms max={:.3} ms over {} frames",
+                self.sum_ns / f64::from(self.n) / 1e6,
+                self.max_ns / 1e6,
+                self.n
+            );
+            (self.sum_ns, self.max_ns, self.n) = (0.0, 0.0, 0);
+        }
+    }
+}
