+/// Log the codec's own GPU timings (dequant, inverse wavelet) every [`GPU_STATS_EVERY`] frames.
+static GPU_STATS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Frames between two readouts of the codec's GPU timings. Five seconds at 120 Hz.
+const GPU_STATS_EVERY: u32 = 600;
+
+/// Turn the periodic GPU timing readout on or off, for decoders that are open or opened later.
+/// The codec writes its timestamps either way; this only reads them out.
+pub fn set_gpu_stats(on: bool) {
+    GPU_STATS.store(on, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// One line of the codec's timing report: `"<step>: <ms> ms per frame"`.
+unsafe extern "C" fn gpu_stats_cb(_ud: *mut c_void, msg: *const c_char) {
+    if msg.is_null() {
+        return;
+    }
+    // SAFETY: the codec passes a NUL-terminated string that lives for this call.
+    let line = unsafe { std::ffi::CStr::from_ptr(msg) }.to_string_lossy();
+    tracing::info!(step = line.trim_end(), "PyroWave GPU time");
+}
