+//! Bounded waits that finish when session lifecycle state changes.
+
+use std::time::Duration;
+
+/// Poll without holding session locks across await. The deadline also bounds a wedged teardown.
+pub(super) async fn wait_until(limit: Duration, mut ready: impl FnMut() -> bool) -> bool {
+    let deadline = tokio::time::Instant::now() + limit;
+    loop {
+        if ready() {
+            return true;
+        }
+        let now = tokio::time::Instant::now();
+        if now >= deadline {
+            return false;
+        }
+        tokio::time::sleep_until((now + Duration::from_millis(10)).min(deadline)).await;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    };
+    use std::time::Instant;
+
+    fn runtime() -> tokio::runtime::Runtime {
+        tokio::runtime::Builder::new_current_thread()
+            .enable_time()
+            .build()
+            .unwrap()
+    }
+
+    #[test]
+    fn completed_handoff_has_no_grace_delay() {
+        let began = Instant::now();
+        assert!(runtime().block_on(wait_until(Duration::from_millis(1500), || true)));
+        assert!(began.elapsed() < Duration::from_millis(250));
+    }
+
+    #[test]
+    fn pending_handoff_is_bounded() {
+        let began = Instant::now();
+        assert!(!runtime().block_on(wait_until(Duration::from_millis(50), || false)));
+        assert!(began.elapsed() >= Duration::from_millis(50));
+        assert!(began.elapsed() < Duration::from_millis(500));
+    }
+
+    #[test]
+    fn preemption_interrupts_the_video_drain() {
+        let stop = Arc::new(AtomicBool::new(false));
+        let signal = stop.clone();
+        let began = Instant::now();
+        let worker = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(30));
+            signal.store(true, Ordering::SeqCst);
+        });
+        assert!(
+            runtime().block_on(wait_until(Duration::from_secs(1), || stop.load(Ordering::SeqCst)))
+        );
+        worker.join().unwrap();
+        assert!(began.elapsed() < Duration::from_millis(500));
+    }
+}
