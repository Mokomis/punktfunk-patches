                             }
                         }
                     }
-                    thread::sleep(interval);
+                    crate::pinger_wait::wait(&stop_t, interval);
                 }
             });
         // Not `thread::spawn`: that panics if the OS refuses the thread, and
diff --git a/crates/host/punktfunk-host/src/native.rs b/crates/host/punktfunk-host/src/native.rs
index 6a30cc1e7..0e9c94c57 100644
--- a/crates/host/punktfunk-host/src/native.rs
+++ b/crates/host/punktfunk-host/src/native.rs
@@ -583,6 +583,15 @@ const SIDE_THREAD_JOIN_GRACE: std::time::Duration = std::time::Duration::from_se
 
 /// Resolves once `stop` has been set for [`STREAM_STOP_GRACE`].
 /// Polled: `stop` is a plain flag shared with blocking threads (500 ms, one relaxed load).
+/// Up to 1 s for queued video to leave before close, cut short when the session was stopped:
+/// a reconnect waits on this teardown, and a stopped session has nothing left worth sending.
+async fn drain_window(stop: &AtomicBool) {
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(1);
+    while !stop.load(Ordering::SeqCst) && tokio::time::Instant::now() < deadline {
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    }
+}
+
 async fn stop_overdue(stop: &AtomicBool) {
     while !stop.load(Ordering::SeqCst) {
         tokio::time::sleep(std::time::Duration::from_millis(500)).await;
@@ -1667,8 +1676,9 @@ pub(crate) async fn run_admitted(
                 anyhow::bail!("stream thread wedged after stop");
             }
         }
-        // Drain window before close.
-        tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+        // Drain window before close: a normal end lets queued video leave; a stopped
+        // (preempted or reconnecting) session closes its side planes at once.
+        drain_window(&stop).await;
         Ok(())
     }
     .await;
diff --git a/crates/host/punktfunk-host/src/native/audio.rs b/crates/host/punktfunk-host/src/native/audio.rs
index 1f5ebeeec..fa935a285 100644
--- a/crates/host/punktfunk-host/src/native/audio.rs
+++ b/crates/host/punktfunk-host/src/native/audio.rs
@@ -488,6 +488,10 @@ pub(super) fn audio_thread(
         // Wake on a chunk or the next owed slot, whichever first. Waiting only on capture
         // made a hole cost more than the audio it swallowed — see [`InfillPolicy`].
         let wake = pacer.wake_budget(std::time::Instant::now(), acc.len());
+        // A silent Windows sink delivers nothing, and an unbounded wait there blocks for 5 s:
+        // bound it so a stopped session releases the parked capture promptly.
+        #[cfg(windows)]
+        let wake = wake.or(Some(std::time::Duration::from_millis(100)));
         let Some(chunk) = lease.next_chunk(wake) else {
             continue;
         };
