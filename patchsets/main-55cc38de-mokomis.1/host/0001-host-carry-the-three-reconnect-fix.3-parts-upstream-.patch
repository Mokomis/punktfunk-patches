+++ b/crates/host/pf-vdisplay/src/vdisplay/windows/manager.rs
@@ -521,12 +521,12 @@ struct Pinger {
 }
 
 impl Pinger {
-    /// Signal and join. The pinger's join is bounded by its interval (watchdog/3 s), the
-    /// exclusive watch's by its 250 ms slices: it only `try_lock`s the state lock, so stopping
-    /// it under that lock cannot deadlock.
+    /// Signal, wake and join. The pinger parks between pings, so the wake ends its interval at
+    /// once instead of after up to watchdog/3 s; the exclusive watch's join is bounded by its
+    /// 250 ms slices: it only `try_lock`s the state lock, so stopping it under that lock cannot
+    /// deadlock.
     fn stop(self) {
-        self.stop.store(true, Ordering::Relaxed);
-        let _ = self.thread.join();
+        crate::pinger_wait::stop_and_join(&self.stop, self.thread);
     }
 }
 
