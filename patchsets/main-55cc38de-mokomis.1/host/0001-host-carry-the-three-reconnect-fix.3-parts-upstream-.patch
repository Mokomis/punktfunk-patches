--- /dev/null
+++ b/crates/host/pf-vdisplay/src/pinger_wait.rs
@@ -0,0 +1,49 @@
+//! Interruptible interval between virtual-display keepalive calls.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+pub(crate) fn wait(stop: &AtomicBool, interval: Duration) {
+    if !stop.load(Ordering::Relaxed) {
+        thread::park_timeout(interval);
+    }
+}
+
+pub(crate) fn stop_and_join(stop: &AtomicBool, worker: JoinHandle<()>) {
+    stop.store(true, Ordering::Relaxed);
+    worker.thread().unpark();
+    let _ = worker.join();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{mpsc, Arc};
+    use std::time::Instant;
+
+    #[test]
+    fn teardown_wakes_a_long_keepalive_interval() {
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = stop.clone();
+        let (ready, started) = mpsc::channel();
+        let worker = thread::spawn(move || {
+            ready.send(()).unwrap();
+            while !flag.load(Ordering::Relaxed) {
+                wait(&flag, Duration::from_secs(3));
+            }
+        });
+        started.recv().unwrap();
+        let begin = Instant::now();
+        stop_and_join(&stop, worker);
+        assert!(begin.elapsed() < Duration::from_millis(500));
+    }
+
+    #[test]
+    fn stop_before_the_wait_returns_without_parking() {
+        let stop = AtomicBool::new(true);
+        let begin = Instant::now();
+        wait(&stop, Duration::from_secs(3));
+        assert!(begin.elapsed() < Duration::from_millis(500));
+    }
+}
diff --git a/crates/host/pf-vdisplay/src/vdisplay/windows/manager.rs b/crates/host/pf-vdisplay/src/vdisplay/windows/manager.rs
