diff --git a/crates/client/pf-client-video/examples/pyrowave_compare_planes.py b/crates/client/pf-client-video/examples/pyrowave_compare_planes.py
new file mode 100644
index 000000000..3acfab3ce
--- /dev/null
+++ b/crates/client/pf-client-video/examples/pyrowave_compare_planes.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+"""Compare two `pyrowave_planes` dumps of the same capture, decoded on different drivers.
+
+    python3 pyrowave_compare_planes.py <reference-dir> <test-dir> [--maps <out-dir>]
+
+For every frame and plane both dumps hold, prints whether the planes are byte-identical and,
+if not, how and where they differ:
+
+- max / mean absolute difference in 10-bit codes, PSNR against a 1023 peak, and the
+  share of samples off by more than 1 and more than 16 codes. A 10-bit plane is
+  R16_UNORM written from a normalised float, so code = round(sample * 1023 / 65535);
+- the error by 32x32 tile: how many tiles differ, the worst tiles by position, and whether
+  the error sits in the last partial tile column/row (the frame's right and bottom edges
+  when the width or height is not a multiple of 32).
+
+`--maps` writes one PGM image per differing plane: each pixel is the absolute difference
+in codes, scaled so 32 or more codes is white. Uses only the Python standard library.
+"""
+import array
+import math
+import os
+import sys
+
+TILE = 32
+
+
+def read_manifest(d):
+    head, planes = [], {}
+    with open(os.path.join(d, "manifest.txt")) as f:
+        for line in f:
+            line = line.rstrip("\n")
+            parts = line.split()
+            if len(parts) == 7 and parts[0].isdigit():
+                frame, au, plane, w, h, bps, sha = parts
+                planes[(int(frame), plane)] = (int(au), int(w), int(h), int(bps), sha)
+            elif not line.startswith("#"):
+                head.append(line)
+    return head, planes
+
+
+def samples(path, bps):
+    a = array.array("H" if bps == 2 else "B")
+    with open(path, "rb") as f:
+        a.frombytes(f.read())
+    if bps == 2 and sys.byteorder != "little":
+        a.byteswap()
+    return a
+
+
+def compare(ref_dir, test_dir, frame, plane, info_r, info_t, maps):
+    au, w, h, bps, sha_r = info_r
+    _, w_t, h_t, bps_t, sha_t = info_t
+    tag = f"frame {frame:4d} (AU {au}) {plane:2s}"
+    if (w, h, bps) != (w_t, h_t, bps_t):
+        print(f"{tag}: SIZE MISMATCH {w}x{h}x{bps} vs {w_t}x{h_t}x{bps_t}")
+        return False
+    if sha_r == sha_t:
+        print(f"{tag}: identical")
+        return True
+    name = f"f{frame:04d}.{plane}"
+    a = samples(os.path.join(ref_dir, name), bps)
+    b = samples(os.path.join(test_dir, name), bps)
+    peak = 1023 if bps == 2 else 255
+    if bps == 2:
+        to_code = [round(v * 1023 / 65535) for v in range(65536)]
+    else:
+        to_code = list(range(256))
+    n = w * h
+    tiles_x, tiles_y = (w + TILE - 1) // TILE, (h + TILE - 1) // TILE
+    tile_err = [0] * (tiles_x * tiles_y)
+    diff_map = bytearray(n) if maps else None
+    max_d = sum_d = sq = over1 = over16 = 0
+    for y in range(h):
+        row = y * w
+        ty = (y // TILE) * tiles_x
+        for x in range(w):
+            d = abs(to_code[a[row + x]] - to_code[b[row + x]])
+            if d:
+                sum_d += d
+                sq += d * d
+                if d > max_d:
+                    max_d = d
+                over1 += d > 1
+                over16 += d > 16
+                tile_err[ty + x // TILE] += d
+                if diff_map is not None:
+                    diff_map[row + x] = min(255, d * 8)
+    mse = sq / n
+    psnr = float("inf") if mse == 0 else 10 * math.log10(peak * peak / mse)
+    bad = [i for i, e in enumerate(tile_err) if e]
+    print(
+        f"{tag}: DIFFERS max {max_d} mean {sum_d / n:.3f} codes, PSNR {psnr:.2f} dB, "
+        f">1: {100 * over1 / n:.3f}%  >16: {100 * over16 / n:.3f}%"
+    )
+    edge_x = w % TILE != 0
+    edge_y = h % TILE != 0
+    edge_err = sum(
+        tile_err[ty * tiles_x + tx]
+        for ty in range(tiles_y)
+        for tx in range(tiles_x)
+        if (edge_x and tx == tiles_x - 1) or (edge_y and ty == tiles_y - 1)
+    )
+    total_err = sum(tile_err)
+    print(
+        f"    tiles: {len(bad)}/{len(tile_err)} differ; "
+        f"partial edge tiles hold {100 * edge_err / total_err:.1f}% of the error"
+        if total_err
+        else "    tiles: none differ in 10-bit codes (only the low bits differ)"
+    )
+    worst = sorted(bad, key=lambda i: -tile_err[i])[:8]
+    if worst:
+        print(
+            "    worst tiles (x,y px: mean codes): "
+            + ", ".join(
+                f"({(i % tiles_x) * TILE},{(i // tiles_x) * TILE}: "
+                f"{tile_err[i] / (TILE * TILE):.1f})"
+                for i in worst
+            )
+        )
+    if diff_map is not None:
+        os.makedirs(maps, exist_ok=True)
+        out = os.path.join(maps, f"diff_{name.replace('.', '_')}.pgm")
+        with open(out, "wb") as f:
+            f.write(f"P5\n{w} {h}\n255\n".encode())
+            f.write(bytes(diff_map))
+        print(f"    map: {out}")
+    return False
+
+
+def main():
+    args = sys.argv[1:]
+    maps = None
+    if "--maps" in args:
+        i = args.index("--maps")
+        maps = args[i + 1]
+        del args[i : i + 2]
+    if len(args) != 2:
+        print(__doc__)
+        sys.exit(2)
+    ref_dir, test_dir = args
+    head_r, planes_r = read_manifest(ref_dir)
+    head_t, planes_t = read_manifest(test_dir)
+    print("reference:")
+    for line in head_r:
+        print("   ", line)
+    print("test:")
+    for line in head_t:
+        print("   ", line)
+    common = sorted(set(planes_r) & set(planes_t))
+    if not common:
+        print("no frame/plane in common")
+        sys.exit(2)
+    au_mismatch = [k for k in common if planes_r[k][0] != planes_t[k][0]]
+    if au_mismatch:
+        print(f"warning: {len(au_mismatch)} planes came from different AUs; compare is not like for like")
+    same = sum(compare(ref_dir, test_dir, f, p, planes_r[(f, p)], planes_t[(f, p)], maps) for f, p in common)
+    print(f"{same}/{len(common)} planes identical")
+    sys.exit(0 if same == len(common) else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/crates/client/pf-client-video/examples/pyrowave_planes.rs b/crates/client/pf-client-video/examples/pyrowave_planes.rs
new file mode 100644
index 000000000..0f276bf05
--- /dev/null
+++ b/crates/client/pf-client-video/examples/pyrowave_planes.rs
@@ -0,0 +1,514 @@
+//! PyroWave plane replay: decode a `PUNKTFUNK_DUMP_VIDEO` capture with the client decoder
+//! and write every decoded frame's raw Y, Cb and Cr planes, so two Vulkan drivers can be
+//! compared on byte-identical input before any colour conversion or presentation.
+//!
+//! `pyrowave_planes <capture> <WxH> <bits> <out-dir> [frames] [444]`
+//!
+//! - `<capture>`: the data file of a capture; its `.idx` sidecar sits next to it.
+//! - `<bits>`: 8 or 10. 10 decodes into R16_UNORM planes of MSB-packed codes, as the client.
+//! - `[frames]`: complete AUs to decode from the start of the capture (default 8).
+//! - `[444]`: the session ran 4:4:4 (default 4:2:0).
+//!
+//! Environment:
+//! - `PYROWAVE_ICD=<path>`: load this Vulkan driver directly (for example Turnip's
+//!   `libvulkan_freedreno.so`) instead of the system loader, as AdrenoTools does.
+//! - `PYROWAVE_PLANES_GPU=<substring>`: pick the adapter by name (the system loader may list
+//!   several, including a CPU one).
+//! - `PYROWAVE_PLANES_IDWT=compute|fragment`: force the inverse-wavelet path.
+//! - `PYROWAVE_PRECISION=0|1|2`: the codec's own precision switch, passed through.
+//!
+//! The output directory gets `fNNNN.y`, `fNNNN.cb`, `fNNNN.cr` (tightly packed rows,
+//! little-endian u16 for 10-bit, u8 for 8-bit) and `manifest.txt`: the driver identity,
+//! then one line per plane with its size and SHA-256. Compare two directories with
+//! `scripts/pyrowave-compare-planes.py`.
+
+#[cfg(not(any(target_os = "linux", windows, target_os = "android")))]
+fn main() {
+    eprintln!("pyrowave_planes runs on Linux, Windows and Android");
+}
+
+#[cfg(any(target_os = "linux", windows, target_os = "android"))]
+fn main() -> anyhow::Result<()> {
+    planes::run()
+}
+
+#[cfg(any(target_os = "linux", windows, target_os = "android"))]
+mod planes {
+    use anyhow::{Context as _, Result, bail, ensure};
+    use ash::vk;
+    use ash::vk::Handle as _;
+    use pf_client_video::video_color::ColorDesc;
+    use pf_client_video::video_pyrowave::{
+        PyroWaveDecoder, PyroWavePlanarFrame, set_idwt_path_override, set_plane_readback,
+    };
+    use pf_client_video::video_vk::{QueueLock, VulkanDecodeDevice};
+    use sha2::{Digest as _, Sha256};
+    use std::fmt::Write as _;
+    use std::path::{Path, PathBuf};
+
+    /// One capture AU: byte range, chunk-aligned, complete.
+    type Au = (std::ops::Range<usize>, bool, bool);
+
+    fn load(path: &str) -> Result<(Vec<u8>, Vec<Au>)> {
+        let data = std::fs::read(path).with_context(|| format!("read {path}"))?;
+        let idx = std::fs::read_to_string(format!("{path}.idx"))
+            .with_context(|| format!("read {path}.idx"))?;
+        let mut aus = Vec::new();
+        for line in idx.lines().filter(|l| !l.trim().is_empty()) {
+            let f: Vec<&str> = line.split_whitespace().collect();
+            let [off, len, flags, complete] = f[..] else {
+                bail!("index line is not `offset len flags complete`: {line}");
+            };
+            let (off, len): (usize, usize) = (off.parse()?, len.parse()?);
+            ensure!(off + len <= data.len(), "index line past the end of the data: {line}");
+            let flags = u32::from_str_radix(flags.trim_start_matches("0x"), 16)?;
+            aus.push((
+                off..off + len,
+                flags & punktfunk_core_flags::CHUNK_ALIGNED != 0,
+                complete == "1",
+            ));
+        }
+        ensure!(!aus.is_empty(), "the capture index lists no AUs");
+        Ok((data, aus))
+    }
+
+    /// `punktfunk_core::packet::USER_FLAG_CHUNK_ALIGNED`, which this crate does not re-export.
+    mod punktfunk_core_flags {
+        pub const CHUNK_ALIGNED: u32 = 0x40;
+    }
+
+    /// The Vulkan entry: the system loader, or a driver loaded by path. A driver loaded by
+    /// path stays loaded for the process's life (the returned library is leaked).
+    fn entry() -> Result<(ash::Entry, String)> {
+        let Some(path) = std::env::var_os("PYROWAVE_ICD") else {
+            // SAFETY: loads the system Vulkan loader; its entry points are valid while the
+            // returned `Entry` lives.
+            return Ok((unsafe { ash::Entry::load() }?, "system loader".into()));
+        };
+        // SAFETY: loading a Vulkan driver runs its initialisers; that is the point.
+        let lib = unsafe { libloading::Library::new(&path) }
+            .with_context(|| format!("load {}", PathBuf::from(&path).display()))?;
+        // An ICD exports `vk_icdGetInstanceProcAddr` (Mesa always does); some builds also
+        // export the plain loader name.
+        type Gipa = vk::PFN_vkGetInstanceProcAddr;
+        type Negotiate = unsafe extern "system" fn(*mut u32) -> vk::Result;
+        // SAFETY: symbol types match the Vulkan ICD interface.
+        let gipa: Gipa = unsafe {
+            match lib.get::<Gipa>(b"vk_icdGetInstanceProcAddr\0") {
+                Ok(s) => *s,
+                Err(_) => *lib
+                    .get::<Gipa>(b"vkGetInstanceProcAddr\0")
+                    .context("the driver exports neither vk_icdGetInstanceProcAddr nor vkGetInstanceProcAddr")?,
+            }
+        };
+        // SAFETY: as above. The loader negotiates before any other call; do the same.
+        if let Ok(neg) = unsafe { lib.get::<Negotiate>(b"vk_icdNegotiateLoaderICDInterfaceVersion\0") } {
+            let mut version = 5u32;
+            // SAFETY: the out-pointer is a live local.
+            let r = unsafe { neg(&mut version) };
+            ensure!(r == vk::Result::SUCCESS, "ICD interface negotiation failed: {r:?}");
+        }
+        let label = format!("driver {}", PathBuf::from(&path).display());
+        std::mem::forget(lib);
+        // SAFETY: `gipa` comes from a library that is never unloaded.
+        let entry = unsafe {
+            ash::Entry::from_static_fn(ash::StaticFn {
+                get_instance_proc_addr: gipa,
+            })
+        };
+        Ok((entry, label))
+    }
+
+    /// The plane sizes of a `w`×`h` frame.
+    fn plane_dims(w: u32, h: u32, chroma444: bool) -> [(u32, u32); 3] {
+        let (cw, ch) = if chroma444 { (w, h) } else { (w / 2, h / 2) };
+        [(w, h), (cw, ch), (cw, ch)]
+    }
+
+    struct Readback {
+        pool: vk::CommandPool,
+        cmd: vk::CommandBuffer,
+        fence: vk::Fence,
+        buf: vk::Buffer,
+        mem: vk::DeviceMemory,
+        size: u64,
+    }
+
+    impl Readback {
+        /// # Safety
+        ///
+        /// `device` is live and `mem_props` are its physical device's.
+        unsafe fn new(
+            device: &ash::Device,
+            mem_props: &vk::PhysicalDeviceMemoryProperties,
+            qf: u32,
+            size: u64,
+        ) -> Result<Readback> {
+            unsafe {
+                let pool = device.create_command_pool(
+                    &vk::CommandPoolCreateInfo::default()
+                        .queue_family_index(qf)
+                        .flags(vk::CommandPoolCreateFlags::RESET_COMMAND_BUFFER),
+                    None,
+                )?;
+                let cmd = device.allocate_command_buffers(
+                    &vk::CommandBufferAllocateInfo::default()
+                        .command_pool(pool)
+                        .command_buffer_count(1),
+                )?[0];
+                let fence = device.create_fence(&vk::FenceCreateInfo::default(), None)?;
+                let buf = device.create_buffer(
+                    &vk::BufferCreateInfo::default()
+                        .size(size)
+                        .usage(vk::BufferUsageFlags::TRANSFER_DST),
+                    None,
+                )?;
+                let req = device.get_buffer_memory_requirements(buf);
+                let want = vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT;
+                let ti = (0..mem_props.memory_type_count)
+                    .find(|&i| {
+                        req.memory_type_bits & (1 << i) != 0
+                            && mem_props.memory_types[i as usize].property_flags.contains(want)
+                    })
+                    .context("no host-visible coherent memory type")?;
+                let mem = device.allocate_memory(
+                    &vk::MemoryAllocateInfo::default()
+                        .allocation_size(req.size)
+                        .memory_type_index(ti),
+                    None,
+                )?;
+                device.bind_buffer_memory(buf, mem, 0)?;
+                Ok(Readback { pool, cmd, fence, buf, mem, size })
+            }
+        }
+
+        /// Copy the frame's three planes into the buffer and return them, one `Vec` each.
+        ///
+        /// # Safety
+        ///
+        /// `device`/`queue` are live; the frame's images are idle in GENERAL layout.
+        unsafe fn read(
+            &self,
+            device: &ash::Device,
+            queue: vk::Queue,
+            lock: &QueueLock,
+            frame: &PyroWavePlanarFrame,
+        ) -> Result<[Vec<u8>; 3]> {
+            let bpp: u64 = if frame.ten_bit { 2 } else { 1 };
+            let dims = plane_dims(frame.width, frame.height, frame.chroma444);
+            let mut offsets = [0u64; 3];
+            let mut at = 0u64;
+            for (i, (w, h)) in dims.iter().enumerate() {
+                offsets[i] = at;
+                at += u64::from(*w) * u64::from(*h) * bpp;
+            }
+            ensure!(at <= self.size, "frame planes ({at} bytes) exceed the readback buffer");
+            unsafe {
+                device.begin_command_buffer(self.cmd, &vk::CommandBufferBeginInfo::default())?;
+                // Decode writes (storage or attachment) become visible to the copy.
+                let before = [vk::MemoryBarrier::default()
+                    .src_access_mask(vk::AccessFlags::MEMORY_WRITE)
+                    .dst_access_mask(vk::AccessFlags::TRANSFER_READ)];
+                device.cmd_pipeline_barrier(
+                    self.cmd,
+                    vk::PipelineStageFlags::ALL_COMMANDS,
+                    vk::PipelineStageFlags::TRANSFER,
+                    vk::DependencyFlags::empty(),
+                    &before,
+                    &[],
+                    &[],
+                );
+                for (i, (w, h)) in dims.iter().enumerate() {
+                    let region = [vk::BufferImageCopy::default()
+                        .buffer_offset(offsets[i])
+                        .image_subresource(
+                            vk::ImageSubresourceLayers::default()
+                                .aspect_mask(vk::ImageAspectFlags::COLOR)
+                                .layer_count(1),
+                        )
+                        .image_extent(vk::Extent3D {
+                            width: *w,
+                            height: *h,
+                            depth: 1,
+                        })];
+                    device.cmd_copy_image_to_buffer(
+                        self.cmd,
+                        vk::Image::from_raw(frame.images[i]),
+                        vk::ImageLayout::GENERAL,
+                        self.buf,
+                        &region,
+                    );
+                }
+                let after = [vk::MemoryBarrier::default()
+                    .src_access_mask(vk::AccessFlags::TRANSFER_WRITE)
+                    .dst_access_mask(vk::AccessFlags::HOST_READ)];
+                device.cmd_pipeline_barrier(
+                    self.cmd,
+                    vk::PipelineStageFlags::TRANSFER,
+                    vk::PipelineStageFlags::HOST,
+                    vk::DependencyFlags::empty(),
+                    &after,
+                    &[],
+                    &[],
+                );
+                device.end_command_buffer(self.cmd)?;
+                device.reset_fences(&[self.fence])?;
+                let cmds = [self.cmd];
+                {
+                    let _held = lock.guard();
+                    device.queue_submit(
+                        queue,
+                        &[vk::SubmitInfo::default().command_buffers(&cmds)],
+                        self.fence,
+                    )?;
+                }
+                device.wait_for_fences(&[self.fence], true, u64::MAX)?;
+                let ptr = device.map_memory(self.mem, 0, at, vk::MemoryMapFlags::empty())?
+                    as *const u8;
+                let all = std::slice::from_raw_parts(ptr, at as usize);
+                let mut out: [Vec<u8>; 3] = Default::default();
+                for i in 0..3 {
+                    let end = if i < 2 { offsets[i + 1] } else { at };
+                    out[i] = all[offsets[i] as usize..end as usize].to_vec();
+                }
+                device.unmap_memory(self.mem);
+                Ok(out)
+            }
+        }
+
+        /// # Safety
+        ///
+        /// `device` is live and idle.
+        unsafe fn destroy(self, device: &ash::Device) {
+            unsafe {
+                device.destroy_buffer(self.buf, None);
+                device.free_memory(self.mem, None);
+                device.destroy_fence(self.fence, None);
+                device.destroy_command_pool(self.pool, None);
+            }
+        }
+    }
+
+    fn hex(bytes: &[u8]) -> String {
+        bytes.iter().fold(String::new(), |mut s, b| {
+            let _ = write!(s, "{b:02x}");
+            s
+        })
+    }
+
+    pub fn run() -> Result<()> {
+        let args: Vec<String> = std::env::args().skip(1).collect();
+        let usage = "usage: pyrowave_planes <capture> <WxH> <bits> <out-dir> [frames] [444]";
+        ensure!(args.len() >= 4, "{usage}");
+        let path = &args[0];
+        let (w, h): (u32, u32) = args[1]
+            .split_once('x')
+            .map(|(w, h)| Ok::<_, std::num::ParseIntError>((w.parse()?, h.parse()?)))
+            .transpose()?
+            .context(usage)?;
+        let bits: u8 = args[2].parse()?;
+        ensure!(bits == 8 || bits == 10, "bits must be 8 or 10");
+        let out_dir = Path::new(&args[3]);
+        let frames: usize = args.get(4).map_or(Ok(8), |s| s.parse())?;
+        let chroma444 = args.get(5).is_some_and(|s| s == "444");
+        std::fs::create_dir_all(out_dir)?;
+
+        match std::env::var("PYROWAVE_PLANES_IDWT").as_deref() {
+            Ok("compute") => set_idwt_path_override(Some(false)),
+            Ok("fragment") => set_idwt_path_override(Some(true)),
+            Ok(other) => bail!("PYROWAVE_PLANES_IDWT must be compute or fragment, not {other}"),
+            Err(_) => {}
+        }
+        set_plane_readback(true);
+
+        let (data, aus) = load(path)?;
+        let (entry, source) = entry()?;
+        let app = vk::ApplicationInfo::default().api_version(vk::API_VERSION_1_3);
+        let instance = unsafe {
+            entry.create_instance(&vk::InstanceCreateInfo::default().application_info(&app), None)
+        }
+        .context("vkCreateInstance")?;
+        let want = std::env::var("PYROWAVE_PLANES_GPU").ok();
+        let (pdev, props) = unsafe { instance.enumerate_physical_devices() }?
+            .into_iter()
+            .map(|p| (p, unsafe { instance.get_physical_device_properties(p) }))
+            .find(|(_, props)| {
+                let name = props.device_name_as_c_str().unwrap_or_default();
+                match &want {
+                    Some(w) => name.to_string_lossy().contains(w.as_str()),
+                    None => true,
+                }
+            })
+            .context("no matching Vulkan adapter")?;
+        let name = props
+            .device_name_as_c_str()
+            .unwrap_or_default()
+            .to_string_lossy()
+            .into_owned();
+        let mut p12 = vk::PhysicalDeviceVulkan12Properties::default();
+        let mut p11 = vk::PhysicalDeviceVulkan11Properties::default();
+        let mut props2 = vk::PhysicalDeviceProperties2::default()
+            .push_next(&mut p12)
+            .push_next(&mut p11);
+        unsafe { instance.get_physical_device_properties2(pdev, &mut props2) };
+        let driver_name = p12.driver_name_as_c_str().unwrap_or_default().to_string_lossy().into_owned();
+        let driver_info = p12.driver_info_as_c_str().unwrap_or_default().to_string_lossy().into_owned();
+        let subgroup_size = p11.subgroup_size;
+
+        let families = unsafe { instance.get_physical_device_queue_family_properties(pdev) };
+        let qf = families
+            .iter()
+            .position(|q| q.queue_flags.contains(vk::QueueFlags::GRAPHICS | vk::QueueFlags::COMPUTE))
+            .context("no graphics+compute queue family")? as u32;
+        let mut have12 = vk::PhysicalDeviceVulkan12Features::default();
+        let mut have = vk::PhysicalDeviceFeatures2::default().push_next(&mut have12);
+        unsafe { instance.get_physical_device_features2(pdev, &mut have) };
+        let float16 = have12.shader_float16 == vk::TRUE;
+
+        let mut v12 = vk::PhysicalDeviceVulkan12Features::default()
+            .timeline_semaphore(true)
+            .storage_buffer8_bit_access(true)
+            .shader_float16(float16);
+        let mut v13 = vk::PhysicalDeviceVulkan13Features::default()
+            .synchronization2(true)
+            .subgroup_size_control(true)
+            .compute_full_subgroups(true);
+        let mut feat = vk::PhysicalDeviceFeatures2::default()
+            .features(vk::PhysicalDeviceFeatures::default().shader_int16(true))
+            .push_next(&mut v12)
+            .push_next(&mut v13);
+        let prio = [1.0f32];
+        let queues = [vk::DeviceQueueCreateInfo::default()
+            .queue_family_index(qf)
+            .queue_priorities(&prio)];
+        let device = unsafe {
+            instance.create_device(
+                pdev,
+                &vk::DeviceCreateInfo::default()
+                    .queue_create_infos(&queues)
+                    .push_next(&mut feat),
+                None,
+            )
+        }
+        .context("vkCreateDevice")?;
+        let queue = unsafe { device.get_device_queue(qf, 0) };
+        let mem_props = unsafe { instance.get_physical_device_memory_properties(pdev) };
+
+        let vkd = VulkanDecodeDevice {
+            get_instance_proc_addr: entry.static_fn().get_instance_proc_addr as usize,
+            instance: instance.handle().as_raw() as usize,
+            physical_device: pdev.as_raw() as usize,
+            device: device.handle().as_raw() as usize,
+            vendor_id: props.vendor_id,
+            device_name: name.clone(),
+            graphics_qf: qf,
+            decode_qf: qf,
+            decode_video_caps: 0,
+            instance_extensions: Vec::new(),
+            device_extensions: Vec::new(),
+            f_sampler_ycbcr: false,
+            f_timeline_semaphore: true,
+            f_synchronization2: true,
+            video_decode: false,
+            pyrowave_decode: true,
+            f_shader_int16: true,
+            f_storage_buffer8: true,
+            f_subgroup_size_control: true,
+            f_compute_full_subgroups: true,
+            f_shader_float16: float16,
+            api_version: props.api_version,
+            queue_families: vec![qf],
+            d3d11_import: false,
+            dmabuf_import: false,
+            vaapi_av1_decode: false,
+            vaapi_hevc_decode: false,
+            d3d11_hdr10: false,
+            d3d11_nv12: false,
+            d3d11_p010: false,
+            adapter_luid: None,
+            queue_lock: std::sync::Arc::new(QueueLock::new()),
+        };
+        // The colour description only labels the frame; the decoded codes do not depend on it.
+        let color = ColorDesc {
+            primaries: 9,
+            transfer: if bits >= 10 { 16 } else { 1 },
+            matrix: 9,
+            full_range: false,
+        };
+        let mut dec = PyroWaveDecoder::new(&vkd, w, h, 1408, chroma444, color, bits >= 10)?;
+
+        let mut manifest = String::new();
+        let _ = writeln!(manifest, "source {source}");
+        let _ = writeln!(manifest, "device {name}");
+        let _ = writeln!(manifest, "vendor {:#06x} device_id {:#06x}", props.vendor_id, props.device_id);
+        let _ = writeln!(manifest, "driver {driver_name} | {driver_info} | id {:?}", p12.driver_id);
+        let _ = writeln!(
+            manifest,
+            "api {}.{}.{} subgroup_size {subgroup_size} float16 {float16}",
+            vk::api_version_major(props.api_version),
+            vk::api_version_minor(props.api_version),
+            vk::api_version_patch(props.api_version)
+        );
+        let _ = writeln!(
+            manifest,
+            "capture {path} mode {w}x{h} bits {bits} chroma {} idwt {} precision {}",
+            if chroma444 { "444" } else { "420" },
+            std::env::var("PYROWAVE_PLANES_IDWT").unwrap_or_else(|_| "codec-default".into()),
+            std::env::var("PYROWAVE_PRECISION").unwrap_or_else(|_| "build-default".into()),
+        );
+        let _ = writeln!(manifest, "# frame au plane width height bytes_per_sample sha256");
+
+        let bpp: u64 = if bits >= 10 { 2 } else { 1 };
+        let max_plane_bytes: u64 = plane_dims(w, h, chroma444)
+            .iter()
+            .map(|(pw, ph)| u64::from(*pw) * u64::from(*ph) * bpp)
+            .sum();
+        // A mid-capture resize can make frames larger than the opening mode; leave room.
+        let rb = unsafe { Readback::new(&device, &mem_props, qf, max_plane_bytes * 4) }?;
+
+        let mut written = 0usize;
+        let mut skipped = 0usize;
+        for (au_index, (range, aligned, complete)) in aus.iter().enumerate() {
+            if written >= frames {
+                break;
+            }
+            if !complete {
+                skipped += 1;
+                continue;
+            }
+            let Some(frame) = dec.decode_frame(&data[range.clone()], *aligned, *complete)? else {
+                skipped += 1;
+                continue;
+            };
+            let planes = unsafe { rb.read(&device, queue, &vkd.queue_lock, &frame) }?;
+            let dims = plane_dims(frame.width, frame.height, frame.chroma444);
+            for (i, (label, plane)) in ["y", "cb", "cr"].iter().zip(planes.iter()).enumerate() {
+                let file = out_dir.join(format!("f{written:04}.{label}"));
+                std::fs::write(&file, plane).with_context(|| format!("write {}", file.display()))?;
+                let _ = writeln!(
+                    manifest,
+                    "{written} {au_index} {label} {} {} {} {}",
+                    dims[i].0,
+                    dims[i].1,
+                    if frame.ten_bit { 2 } else { 1 },
+                    hex(&Sha256::digest(plane)),
+                );
+            }
+            drop(frame);
+            written += 1;
+        }
+        let _ = writeln!(manifest, "# decoded {written} frames, skipped {skipped} AUs");
+        std::fs::write(out_dir.join("manifest.txt"), &manifest)?;
+        print!("{manifest}");
+
+        drop(dec);
+        unsafe {
+            device.device_wait_idle()?;
+            rb.destroy(&device);
+            device.destroy_device(None);
+            instance.destroy_instance(None);
+        }
+        ensure!(written > 0, "no frame decoded");
+        Ok(())
+    }
+}
