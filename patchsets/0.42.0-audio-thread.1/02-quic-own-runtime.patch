@@ -0,0 +1,165 @@
+//! The QUIC endpoint's own runtime.
+//!
+//! quinn spawns the endpoint driver on the runtime that is current when the endpoint is built,
+//! and each connection driver on the one that is current when the connection is accepted. The
+//! socket and the transport's timers register the same way. [`QuicRuntime`] is one worker
+//! thread that runs only those tasks, so session code holding a worker of the serving runtime
+//! cannot delay a datagram or an ACK.
+//!
+//! Nothing else moves. A `quinn::Connection` is a handle: streams and datagrams are used from
+//! the serving runtime and from plain threads, and their wakers cross runtimes.
+
+use anyhow::{Context, Result};
+
+/// Name of the worker thread, as a debugger or a thread list shows it.
+const THREAD_NAME: &str = "punktfunk1-quic";
+
+pub(crate) struct QuicRuntime {
+    /// `Some` until drop.
+    rt: Option<tokio::runtime::Runtime>,
+}
+
+impl QuicRuntime {
+    pub(crate) fn start() -> Result<QuicRuntime> {
+        let rt = tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .thread_name(THREAD_NAME)
+            .enable_all()
+            .build()
+            .context("QUIC runtime")?;
+        tracing::info!(thread = THREAD_NAME, "QUIC endpoint runs on its own runtime");
+        Ok(QuicRuntime { rt: Some(rt) })
+    }
+
+    pub(crate) fn handle(&self) -> &tokio::runtime::Handle {
+        self.rt
+            .as_ref()
+            .expect("the QUIC runtime lives until drop")
+            .handle()
+    }
+
+    /// Build an endpoint with this runtime current, so its driver and socket belong here.
+    pub(crate) fn enter<T>(&self, build: impl FnOnce() -> T) -> T {
+        let _on_quic = self.handle().enter();
+        build()
+    }
+}
+
+impl Drop for QuicRuntime {
+    /// Not a plain drop: that blocks on the worker, which panics inside an async context.
+    fn drop(&mut self) {
+        if let Some(rt) = self.rt.take() {
+            rt.shutdown_background();
+        }
+    }
+}
+
+/// Accept `incoming` with `quic` current, so the connection's driver is spawned there. The
+/// returned handshake is awaited by the caller, on its own runtime.
+pub(crate) fn accept(
+    quic: &tokio::runtime::Handle,
+    incoming: quinn::Incoming,
+) -> Result<quinn::Connecting, quinn::ConnectionError> {
+    let _on_quic = quic.enter();
+    incoming.accept()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use punktfunk_core::quic::endpoint;
+    use std::time::{Duration, Instant};
+
+    /// How long the serving runtime's only thread is held.
+    const BLOCK: Duration = Duration::from_millis(400);
+
+    /// Send one datagram to a loopback client, then block the serving runtime. Returns how
+    /// long the datagram took to arrive.
+    fn datagram_delay_while_serving_blocks(dedicated: bool) -> Duration {
+        let serving = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let client_rt = tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()
+            .unwrap();
+        let quic = QuicRuntime::start().unwrap();
+        let bind = || endpoint::server("127.0.0.1:0".parse().unwrap()).unwrap();
+        let server = if dedicated {
+            quic.enter(bind)
+        } else {
+            let _on_serving = serving.enter();
+            bind()
+        };
+        let addr = server.local_addr().unwrap();
+        let client = client_rt.spawn(async move {
+            let ep = endpoint::client_insecure().unwrap();
+            let conn = ep.connect(addr, "punktfunk").unwrap().await.unwrap();
+            conn.read_datagram().await.unwrap();
+            // The connection must outlive the read, or the host sees a close instead.
+            (Instant::now(), ep, conn)
+        });
+        let quic = quic.handle().clone();
+        serving.block_on(async move {
+            let incoming = server.accept().await.expect("incoming");
+            let conn = if dedicated {
+                accept(&quic, incoming).unwrap().await.unwrap()
+            } else {
+                incoming.await.unwrap()
+            };
+            // Let the handshake's last flight settle, so only the datagram is in question.
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            let sent = Instant::now();
+            conn.send_datagram(b"audio".to_vec().into()).unwrap();
+            std::thread::sleep(BLOCK);
+            let (arrived, _ep, _conn) = client.await.unwrap();
+            arrived.duration_since(sent)
+        })
+    }
+
+    #[test]
+    fn a_blocked_serving_runtime_does_not_delay_a_datagram() {
+        let delay = datagram_delay_while_serving_blocks(true);
+        assert!(delay < BLOCK / 2, "datagram took {delay:?}");
+    }
+
+    /// The control: without the dedicated runtime the same datagram waits out the block.
+    #[test]
+    fn an_endpoint_on_the_serving_runtime_waits_for_it() {
+        let delay = datagram_delay_while_serving_blocks(false);
+        assert!(
+            delay >= BLOCK - Duration::from_millis(50),
+            "datagram took {delay:?}"
+        );
+    }
+
+    #[test]
+    fn tasks_run_on_the_named_thread() {
+        let quic = QuicRuntime::start().unwrap();
+        let name = quic
+            .handle()
+            .spawn(async { std::thread::current().name().map(str::to_owned) });
+        let serving = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .unwrap();
+        assert_eq!(
+            serving.block_on(name).unwrap().as_deref(),
+            Some(THREAD_NAME)
+        );
+    }
+
+    #[test]
+    fn it_drops_inside_an_async_context() {
+        let serving = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .unwrap();
+        serving.block_on(async {
+            let quic = QuicRuntime::start().unwrap();
+            let ran = quic.handle().spawn(async { 7 }).await.unwrap();
+            assert_eq!(ran, 7);
+            drop(quic);
+        });
+    }
+}
