diff --git a/crates/punktfunk-host/src/native/egress_watch.rs b/crates/punktfunk-host/src/native/egress_watch.rs
new file mode 100644
index 000000000..2af07a1b4
--- /dev/null
+++ b/crates/punktfunk-host/src/native/egress_watch.rs
@@ -0,0 +1,327 @@
+//! What became of audio datagrams after `send_datagram` took them.
+//!
+//! `send_datagram` only queues. The connection's driver puts the queue on the wire, and may
+//! not: its task can be starved, or congestion control and pacing can hold it back. Either
+//! way the audio thread's own departures stay punctual while the wire goes quiet.
+//!
+//! [`EgressWatch`] reads the connection before each audio send, one frame apart. Datagrams
+//! still queued a frame later, with no DATAGRAM frame sent in between, are a stall. The
+//! window also keeps the congestion window, RTT and loss, and whether other packets left
+//! during the stall: those say the transport ran and chose to wait.
+
+use std::time::{Duration, Instant};
+
+/// A stall this long is counted, not only measured. Four Opus frames.
+const STALL: Duration = Duration::from_millis(20);
+
+/// One reading of the connection, taken before an audio send.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct LinkSample {
+    /// DATAGRAM frames the connection has sent since it opened: audio, cursor, rumble, HID.
+    pub(crate) dgram_tx: u64,
+    /// UDP datagrams it has sent, all traffic. Moves on an ACK alone.
+    pub(crate) udp_tx: u64,
+    /// Bytes of datagrams accepted and not yet sent.
+    pub(crate) queued: usize,
+    pub(crate) cwnd: u64,
+    pub(crate) rtt: Duration,
+    pub(crate) lost_packets: u64,
+    pub(crate) congestion_events: u64,
+}
+
+/// One reporting window. Counters reset with the window; `cwnd` and `rtt_ms` are its last reading.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct EgressWindow {
+    /// Sends that found the queue full. Each makes the connection drop its oldest datagram.
+    pub(crate) evicting_sends: u64,
+    /// Most bytes found waiting. Zero on a connection that sends each frame before the next.
+    pub(crate) queue_max: usize,
+    /// Stalls of at least [`STALL`].
+    pub(crate) stalls: u64,
+    /// Longest stretch with datagrams queued and none sent, ms.
+    pub(crate) stall_max_ms: u64,
+    /// Congestion window when the longest stall was last seen. Zero without a stall.
+    pub(crate) stall_cwnd: u64,
+    /// UDP datagrams the connection sent during that stall. Above zero, its driver was running.
+    pub(crate) stall_udp_tx: u64,
+    pub(crate) cwnd: u64,
+    pub(crate) cwnd_min: u64,
+    pub(crate) rtt_ms: u64,
+    pub(crate) rtt_max_ms: u64,
+    pub(crate) lost_packets: u64,
+    pub(crate) congestion_events: u64,
+}
+
+pub(crate) struct EgressWatch {
+    /// Queue size at which the next send evicts.
+    buffer: usize,
+    /// `dgram_tx` at the previous reading.
+    prev_dgram_tx: Option<u64>,
+    /// When datagrams were last seen moving, and `udp_tx` then.
+    moved: Option<(Instant, u64)>,
+    /// Loss and congestion totals at the window's start.
+    base: Option<(u64, u64)>,
+    /// The stall in progress has been counted.
+    counted: bool,
+    win: EgressWindow,
+}
+
+impl EgressWatch {
+    pub(crate) fn new(buffer: usize) -> EgressWatch {
+        EgressWatch {
+            buffer,
+            prev_dgram_tx: None,
+            moved: None,
+            base: None,
+            counted: false,
+            win: EgressWindow::default(),
+        }
+    }
+
+    /// Record the reading taken just before a send.
+    pub(crate) fn observe(&mut self, now: Instant, s: LinkSample) {
+        let w = &mut self.win;
+        if s.queued >= self.buffer {
+            w.evicting_sends += 1;
+        }
+        w.queue_max = w.queue_max.max(s.queued);
+        w.cwnd_min = if self.base.is_none() {
+            s.cwnd
+        } else {
+            w.cwnd_min.min(s.cwnd)
+        };
+        w.cwnd = s.cwnd;
+        w.rtt_ms = s.rtt.as_millis() as u64;
+        w.rtt_max_ms = w.rtt_max_ms.max(w.rtt_ms);
+        let (lost0, cong0) = *self
+            .base
+            .get_or_insert((s.lost_packets, s.congestion_events));
+        w.lost_packets = s.lost_packets.saturating_sub(lost0);
+        w.congestion_events = s.congestion_events.saturating_sub(cong0);
+
+        // Moving: a datagram left since the last reading, or none is waiting.
+        let held = s.queued > 0 && self.prev_dgram_tx == Some(s.dgram_tx);
+        self.prev_dgram_tx = Some(s.dgram_tx);
+        match self.moved {
+            Some((since, udp_then)) if held => {
+                let stalled = now.duration_since(since);
+                let ms = stalled.as_millis() as u64;
+                if ms >= w.stall_max_ms {
+                    w.stall_max_ms = ms;
+                    w.stall_cwnd = s.cwnd;
+                    w.stall_udp_tx = s.udp_tx.saturating_sub(udp_then);
+                }
+                if stalled >= STALL && !std::mem::replace(&mut self.counted, true) {
+                    w.stalls += 1;
+                }
+            }
+            _ => {
+                self.moved = Some((now, s.udp_tx));
+                self.counted = false;
+            }
+        }
+    }
+
+    /// Close the window. A stall in progress carries into the next one.
+    pub(crate) fn take(&mut self) -> EgressWindow {
+        self.base = None;
+        std::mem::take(&mut self.win)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const BUFFER: usize = 4096;
+    const MS: fn(u64) -> Duration = Duration::from_millis;
+
+    fn sample(dgram_tx: u64, queued: usize) -> LinkSample {
+        LinkSample {
+            dgram_tx,
+            udp_tx: dgram_tx,
+            queued,
+            cwnd: 12_000,
+            rtt: MS(3),
+            lost_packets: 0,
+            congestion_events: 0,
+        }
+    }
+
+    #[test]
+    fn a_connection_that_keeps_up_reports_nothing() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        for i in 0..200u64 {
+            w.observe(t0 + MS(5 * i), sample(i, 0));
+        }
+        let win = w.take();
+        assert_eq!((win.stalls, win.stall_max_ms, win.queue_max), (0, 0, 0));
+        assert_eq!((win.evicting_sends, win.stall_cwnd), (0, 0));
+        assert_eq!((win.cwnd, win.cwnd_min, win.rtt_ms), (12_000, 12_000, 3));
+    }
+
+    #[test]
+    fn a_quiet_wire_with_a_queue_is_one_stall_however_long() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        w.observe(t0, sample(10, 0));
+        // 100 ms: the queue grows a frame at a time and nothing leaves.
+        for i in 1..=20u64 {
+            w.observe(t0 + MS(5 * i), sample(10, 110 * i as usize));
+        }
+        // The burst goes out.
+        w.observe(t0 + MS(105), sample(14, 0));
+        let win = w.take();
+        assert_eq!(win.stalls, 1);
+        assert_eq!(win.stall_max_ms, 100);
+        assert_eq!(win.queue_max, 2200);
+        assert_eq!((win.stall_cwnd, win.stall_udp_tx), (12_000, 0));
+        assert_eq!(win.evicting_sends, 0);
+    }
+
+    #[test]
+    fn packets_that_leave_during_a_stall_are_reported_with_it() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        w.observe(t0, sample(10, 0));
+        // Datagrams held for 50 ms while three ACK-only packets go out.
+        for i in 1..=10u64 {
+            let mut s = sample(10, 110 * i as usize);
+            s.udp_tx = 10 + i.min(3);
+            w.observe(t0 + MS(5 * i), s);
+        }
+        let win = w.take();
+        assert_eq!((win.stalls, win.stall_max_ms, win.stall_udp_tx), (1, 50, 3));
+    }
+
+    #[test]
+    fn a_frame_that_waits_one_slot_is_measured_but_not_counted() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        w.observe(t0, sample(1, 0));
+        w.observe(t0 + MS(5), sample(1, 110));
+        w.observe(t0 + MS(10), sample(3, 0));
+        let win = w.take();
+        assert_eq!((win.stalls, win.stall_max_ms, win.queue_max), (0, 5, 110));
+    }
+
+    #[test]
+    fn a_queue_that_drains_slowly_is_not_a_stall() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        for i in 0..40u64 {
+            w.observe(t0 + MS(5 * i), sample(i, 330));
+        }
+        let win = w.take();
+        assert_eq!((win.stalls, win.stall_max_ms, win.queue_max), (0, 0, 330));
+    }
+
+    #[test]
+    fn an_idle_stretch_without_readings_is_not_a_stall() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        w.observe(t0, sample(5, 0));
+        // Ten silent seconds: no sends, so no readings. Nothing was waiting.
+        w.observe(t0 + MS(10_000), sample(5, 0));
+        assert_eq!(w.take().stall_max_ms, 0);
+    }
+
+    #[test]
+    fn a_full_queue_counts_each_send_that_evicts() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        w.observe(t0, sample(1, 0));
+        w.observe(t0 + MS(5), sample(1, 4000));
+        w.observe(t0 + MS(10), sample(1, BUFFER));
+        w.observe(t0 + MS(15), sample(1, BUFFER));
+        let win = w.take();
+        assert_eq!(win.evicting_sends, 2);
+        assert_eq!(win.queue_max, BUFFER);
+    }
+
+    #[test]
+    fn loss_and_the_window_floor_are_per_window() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        let mut s = sample(1, 0);
+        (s.lost_packets, s.congestion_events) = (7, 2);
+        w.observe(t0, s);
+        (s.dgram_tx, s.cwnd, s.lost_packets, s.congestion_events) = (2, 6_000, 9, 3);
+        s.rtt = MS(40);
+        w.observe(t0 + MS(5), s);
+        (s.dgram_tx, s.cwnd, s.rtt) = (3, 9_000, MS(4));
+        w.observe(t0 + MS(10), s);
+        let win = w.take();
+        assert_eq!((win.lost_packets, win.congestion_events), (2, 1));
+        assert_eq!((win.cwnd, win.cwnd_min), (9_000, 6_000));
+        assert_eq!((win.rtt_ms, win.rtt_max_ms), (4, 40));
+
+        // The next window starts from the totals it first sees.
+        s.dgram_tx = 4;
+        w.observe(t0 + MS(15), s);
+        let win = w.take();
+        assert_eq!((win.lost_packets, win.congestion_events), (0, 0));
+        assert_eq!(win.cwnd_min, 9_000);
+    }
+
+    #[test]
+    fn a_stall_across_the_window_edge_is_counted_once() {
+        let t0 = Instant::now();
+        let mut w = EgressWatch::new(BUFFER);
+        w.observe(t0, sample(1, 0));
+        for i in 1..=6u64 {
+            w.observe(t0 + MS(5 * i), sample(1, 100));
+        }
+        let first = w.take();
+        assert_eq!((first.stalls, first.stall_max_ms), (1, 30));
+        w.observe(t0 + MS(35), sample(1, 100));
+        let second = w.take();
+        assert_eq!((second.stalls, second.stall_max_ms), (0, 35));
+    }
+
+    /// The readings against a real connection. On one thread the driver cannot run until
+    /// this task yields, so the queue fills, then evicts, and the client gets the remainder.
+    #[tokio::test]
+    async fn a_real_connection_reads_as_the_watch_expects() {
+        use punktfunk_core::quic::endpoint;
+        let server = endpoint::server("127.0.0.1:0".parse().unwrap()).unwrap();
+        let addr = server.local_addr().unwrap();
+        let accept = tokio::spawn(async move {
+            let conn = server.accept().await.expect("incoming").await.unwrap();
+            (server, conn)
+        });
+        let client = endpoint::client_insecure().unwrap();
+        let client_conn = client.connect(addr, "punktfunk").unwrap().await.unwrap();
+        let (_server, host_conn) = accept.await.unwrap();
+        let link = super::super::link::SessionLink::Quic(host_conn);
+        tokio::time::sleep(MS(100)).await;
+        let before = link.egress_sample();
+        assert_eq!(before.queued, 0);
+
+        // 60 × 100 B against a 4096 B queue: sends 41..59 each find it full and evict one.
+        let buffer = endpoint::DATAGRAM_SEND_BUFFER;
+        let mut w = EgressWatch::new(buffer);
+        let t0 = Instant::now();
+        for i in 0..60u64 {
+            w.observe(t0 + MS(5 * i), link.egress_sample());
+            assert!(link.send_datagram(vec![0u8; 100]).is_sent());
+        }
+        let held = link.egress_sample();
+        assert_eq!((held.queued, held.dgram_tx), (buffer, before.dgram_tx));
+        let win = w.take();
+        assert_eq!((win.evicting_sends, win.queue_max), (19, buffer));
+        assert_eq!((win.stalls, win.stall_max_ms), (1, 295));
+
+        let mut delivered = 0u64;
+        while let Ok(Ok(_)) = tokio::time::timeout(MS(500), client_conn.read_datagram()).await {
+            delivered += 1;
+        }
+        assert_eq!(delivered, 60 - win.evicting_sends);
+        let after = link.egress_sample();
+        assert_eq!(
+            (after.queued, after.dgram_tx - before.dgram_tx),
+            (0, delivered)
+        );
+    }
+}
