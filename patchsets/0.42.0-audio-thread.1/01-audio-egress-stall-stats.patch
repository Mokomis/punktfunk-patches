--- /dev/null
+++ b/crates/punktfunk-host/src/native/rt_lag.rs
@@ -0,0 +1,200 @@
+//! How late an async runtime runs what it is asked to run.
+//!
+//! [`RtLag`] is one small task on the runtime being measured. It reports two delays, both of
+//! which a QUIC connection driver on that runtime suffers too:
+//!
+//! * timer: how long after its deadline a [`TICK`] sleep returns. The transport's own loss,
+//!   pacing and keep-alive timers wait the same way.
+//! * wake: how long a wake from another thread takes to reach the task. A `send_datagram`
+//!   from the audio thread wakes the driver the same way.
+//!
+//! Neither sees a task that is itself stuck behind another on a free runtime.
+//!
+//! Dropping the handle ends the task.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+/// Probe period. One Opus frame, so a reading exists for every audio datagram.
+const TICK: Duration = Duration::from_millis(5);
+
+/// A timer or wake this late is counted. Above the 15.6 ms default Windows timer period.
+const LATE: Duration = Duration::from_millis(20);
+
+/// One reporting window of [`RtLag`].
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct LagWindow {
+    pub(crate) timer_max_ms: u64,
+    pub(crate) wake_max_ms: u64,
+    /// Timer or wake delays of at least [`LATE`].
+    pub(crate) late: u64,
+}
+
+#[derive(Default)]
+struct Shared {
+    timer_max_us: AtomicU64,
+    wake_max_us: AtomicU64,
+    late: AtomicU64,
+    /// Nanoseconds since `epoch` of the oldest unanswered [`RtLag::ping`], plus one. Zero is none.
+    pinged: AtomicU64,
+    notify: tokio::sync::Notify,
+}
+
+impl Shared {
+    fn record(&self, max_us: &AtomicU64, delay: Duration) {
+        max_us.fetch_max(delay.as_micros() as u64, Ordering::Relaxed);
+        if delay >= LATE {
+            self.late.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
+
+pub(crate) struct RtLag {
+    shared: Arc<Shared>,
+    epoch: Instant,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl RtLag {
+    /// Start measuring the runtime behind `rt`.
+    pub(crate) fn spawn(rt: &tokio::runtime::Handle) -> RtLag {
+        let shared = Arc::new(Shared::default());
+        let epoch = Instant::now();
+        let task = rt.spawn(probe(shared.clone(), epoch));
+        RtLag {
+            shared,
+            epoch,
+            task,
+        }
+    }
+
+    /// Wake the probe from the calling thread. An unanswered ping keeps its timestamp, so the
+    /// delay reported is the oldest one outstanding.
+    pub(crate) fn ping(&self) {
+        let stamp = self.epoch.elapsed().as_nanos() as u64 + 1;
+        let fresh = self
+            .shared
+            .pinged
+            .compare_exchange(0, stamp, Ordering::AcqRel, Ordering::Relaxed)
+            .is_ok();
+        if fresh {
+            self.shared.notify.notify_one();
+        }
+    }
+
+    /// Close the window.
+    pub(crate) fn take(&self) -> LagWindow {
+        let s = &self.shared;
+        LagWindow {
+            timer_max_ms: s.timer_max_us.swap(0, Ordering::Relaxed) / 1_000,
+            wake_max_ms: s.wake_max_us.swap(0, Ordering::Relaxed) / 1_000,
+            late: s.late.swap(0, Ordering::Relaxed),
+        }
+    }
+}
+
+impl Drop for RtLag {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn probe(shared: Arc<Shared>, epoch: Instant) {
+    let mut due = tokio::time::Instant::now() + TICK;
+    loop {
+        tokio::select! {
+            () = tokio::time::sleep_until(due) => {
+                let now = tokio::time::Instant::now();
+                shared.record(&shared.timer_max_us, now.saturating_duration_since(due));
+                // From now, not from `due`: a late tick must not be charged to the next one.
+                due = now + TICK;
+            }
+            () = shared.notify.notified() => {
+                let stamp = shared.pinged.swap(0, Ordering::AcqRel);
+                if stamp != 0 {
+                    let sent = Duration::from_nanos(stamp - 1);
+                    shared.record(&shared.wake_max_us, epoch.elapsed().saturating_sub(sent));
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MS: fn(u64) -> Duration = Duration::from_millis;
+
+    /// A one-thread runtime driven from its own thread, like the probe's real hosts.
+    fn runtime() -> tokio::runtime::Runtime {
+        tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()
+            .unwrap()
+    }
+
+    #[test]
+    fn a_blocked_runtime_shows_in_both_delays() {
+        let rt = runtime();
+        let lag = RtLag::spawn(rt.handle());
+        std::thread::sleep(MS(30));
+        // The only worker blocks for 150 ms. The ping lands inside that.
+        let blocker = rt.spawn(async { std::thread::sleep(MS(150)) });
+        std::thread::sleep(MS(30));
+        lag.ping();
+        rt.block_on(blocker).unwrap();
+        std::thread::sleep(MS(30));
+        let win = lag.take();
+        assert!(win.timer_max_ms >= 100, "timer {win:?}");
+        assert!(win.wake_max_ms >= 60, "wake {win:?}");
+        assert!(win.late >= 2, "late {win:?}");
+    }
+
+    #[test]
+    fn an_idle_runtime_answers_pings_and_take_resets_the_window() {
+        let rt = runtime();
+        let lag = RtLag::spawn(rt.handle());
+        for _ in 0..20 {
+            lag.ping();
+            std::thread::sleep(MS(5));
+        }
+        // Loose: a loaded test machine may run this late, but not by the blocked case's margin.
+        let win = lag.take();
+        assert!(win.wake_max_ms < 100, "wake {win:?}");
+        assert!(win.timer_max_ms < 100, "timer {win:?}");
+        assert_eq!(lag.shared.pinged.load(Ordering::Acquire), 0);
+        std::thread::sleep(MS(20));
+        assert!(lag.take().timer_max_ms < 100);
+    }
+
+    #[test]
+    fn an_unanswered_ping_keeps_the_oldest_timestamp() {
+        let rt = runtime();
+        let lag = RtLag::spawn(rt.handle());
+        std::thread::sleep(MS(20));
+        let blocker = rt.spawn(async { std::thread::sleep(MS(120)) });
+        std::thread::sleep(MS(20));
+        lag.ping();
+        let first = lag.shared.pinged.load(Ordering::Acquire);
+        std::thread::sleep(MS(40));
+        lag.ping();
+        assert_eq!(lag.shared.pinged.load(Ordering::Acquire), first);
+        rt.block_on(blocker).unwrap();
+        std::thread::sleep(MS(30));
+        assert!(lag.take().wake_max_ms >= 60);
+    }
+
+    #[test]
+    fn dropping_the_handle_ends_the_probe() {
+        let rt = runtime();
+        let lag = RtLag::spawn(rt.handle());
+        let shared = lag.shared.clone();
+        drop(lag);
+        std::thread::sleep(MS(50));
+        // Only this test's clone is left once the aborted task has dropped its own.
+        assert_eq!(Arc::strong_count(&shared), 1);
+    }
+}
