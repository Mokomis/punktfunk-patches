+    /// The connection as the audio sender finds it, read before a send. Two short locks.
+    pub(crate) fn egress_sample(&self) -> super::egress_watch::LinkSample {
+        let quic = self.quic();
+        let stats = quic.stats();
+        // Only the native plane's queue is sized by this host. A browser's reads as empty.
+        let queued = match self {
+            SessionLink::Quic(c) => punktfunk_core::quic::endpoint::DATAGRAM_SEND_BUFFER
+                .saturating_sub(c.datagram_send_buffer_space()),
+            SessionLink::Web(..) => 0,
+        };
+        super::egress_watch::LinkSample {
+            dgram_tx: stats.frame_tx.datagram,
+            udp_tx: stats.udp_tx.datagrams,
+            queued,
+            cwnd: stats.path.cwnd,
+            rtt: stats.path.rtt,
+            lost_packets: stats.path.lost_packets,
+            congestion_events: stats.path.congestion_events,
+        }
+    }
