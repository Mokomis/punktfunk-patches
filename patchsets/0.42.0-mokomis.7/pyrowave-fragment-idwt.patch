+/// Which inverse-wavelet path to open the decoder with: 0 = ask the codec
+/// (`pyrowave_decoder_device_prefers_fragment_path`), 1 = compute, 2 = fragment.
+static IDWT_PATH: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+/// Force the inverse-wavelet path for decoders opened after this call, or `None` to let the
+/// codec choose per driver. The codec's author found Qualcomm's and Arm's own drivers much
+/// faster on the fragment path and Mesa's Turnip fine on compute; this is the escape hatch
+/// for a device where that guess is wrong.
+pub fn set_idwt_path_override(fragment: Option<bool>) {
+    let v = match fragment {
+        None => 0,
+        Some(false) => 1,
+        Some(true) => 2,
+    };
+    IDWT_PATH.store(v, std::sync::atomic::Ordering::Relaxed);
+}
+
+fn idwt_path_override() -> Option<bool> {
+    match IDWT_PATH.load(std::sync::atomic::Ordering::Relaxed) {
+        1 => Some(false),
+        2 => Some(true),
+        _ => None,
+    }
+}
