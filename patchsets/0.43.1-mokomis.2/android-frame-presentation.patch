+/// The user's "Frame presentation" setting (`android.frame_presentation`), process-wide like
+/// the transport defaults: [`PRESENT_AUTO`], [`PRESENT_DIRECT`] or [`PRESENT_ARRIVAL`].
+static FRAME_PRESENTATION: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+/// The platform's own choice: ASurfaceControl everywhere but ChromeOS.
+pub(crate) const PRESENT_AUTO: u8 = 0;
+/// The SurfaceView with the timeline presenter.
+pub(crate) const PRESENT_DIRECT: u8 = 1;
+/// The SurfaceView with each frame released the moment it is decoded.
+pub(crate) const PRESENT_ARRIVAL: u8 = 2;
+
+/// Store the setting for sessions started after this call. Unknown values mean automatic.
+pub(crate) fn set_frame_presentation(mode: u8) {
+    let mode = if mode <= PRESENT_ARRIVAL { mode } else { PRESENT_AUTO };
+    FRAME_PRESENTATION.store(mode, std::sync::atomic::Ordering::Relaxed);
+}
+
+fn frame_presentation() -> u8 {
+    FRAME_PRESENTATION.load(std::sync::atomic::Ordering::Relaxed)
+}
