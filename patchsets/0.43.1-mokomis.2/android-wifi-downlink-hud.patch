+
+/**
+ * The overlay's Wi-Fi line: the downlink rate the radio reports, and whether this connection has
+ * shown a 320 MHz downlink. Android reports no downlink width, so it is inferred from the rate —
+ * above [MAX_160_MBPS] only a 320 MHz channel can carry two streams. A lower rate proves nothing
+ * on its own (a 320 MHz link also runs slower codings), so the answer comes from the peak over
+ * [WINDOW_MS]: the width only shows under load, and a minute of stream is load enough.
+ */
+internal class WifiHud {
+    private val samples = ArrayDeque<Pair<Long, Int>>()
+
+    /** The line for [link] read at [nowMs], or null off Wi-Fi or without a downlink rate. */
+    fun line(link: WifiLink, nowMs: Long): HudLine? {
+        if (link.freqMhz <= 0 || link.rxMbps <= 0) {
+            samples.clear()
+            return null
+        }
+        samples.addLast(nowMs to link.rxMbps)
+        while (nowMs - samples.first().first > WINDOW_MS) samples.removeFirst()
+        val peak = samples.maxOf { it.second }
+        val watchedMs = nowMs - samples.first().first
+        return when {
+            peak > MAX_160_MBPS -> HudLine(2, "wi-fi ↓ ${link.rxMbps} Mb/s · 320 MHz")
+            watchedMs >= SETTLE_MS -> HudLine(3, "wi-fi ↓ ${link.rxMbps} Mb/s · no 320 MHz seen")
+            else -> HudLine(2, "wi-fi ↓ ${link.rxMbps} Mb/s")
+        }
+    }
+
+    companion object {
+        /** Two streams of 4096-QAM 5/6 at 160 MHz, rounded up: the most a narrower link reports. */
+        const val MAX_160_MBPS = 2_883
+        const val WINDOW_MS = 60_000L
+        const val SETTLE_MS = 30_000L
+    }
+}
diff --git a/clients/android/app/src/test/kotlin/io/unom/punktfunk/WifiLinkLogTest.kt b/clients/android/app/src/test/kotlin/io/unom/punktfunk/WifiLinkLogTest.kt
index fe89207b2..e55a89d32 100644
--- a/clients/android/app/src/test/kotlin/io/unom/punktfunk/WifiLinkLogTest.kt
+++ b/clients/android/app/src/test/kotlin/io/unom/punktfunk/WifiLinkLogTest.kt
@@ -41,4 +41,25 @@ class WifiLinkLogTest {
         assertEquals("periodic", log.reason(base, WifiLinkLog.PERIOD_MS))
         assertNull(log.reason(base, WifiLinkLog.PERIOD_MS + 1_000))
     }
+
+    @Test
+    fun hudNamesA320MhzDownlinkOnlyFromARateNothingNarrowerReaches() {
+        val hud = WifiHud()
+        val six = base.copy(freqMhz = 6375)
+        assertEquals("wi-fi ↓ 2402 Mb/s", hud.line(six.copy(rxMbps = 2402), 0)?.text)
+        assertEquals("wi-fi ↓ 3843 Mb/s · 320 MHz", hud.line(six.copy(rxMbps = 3843), 1_000)?.text)
+        // A slower coding on the same connection keeps the verdict while the peak is in the window.
+        assertEquals("wi-fi ↓ 1729 Mb/s · 320 MHz", hud.line(six.copy(rxMbps = 1729), 30_000)?.text)
+    }
+
+    @Test
+    fun hudWarnsOnceAHalfMinuteOfStreamShowedNo320Mhz() {
+        val hud = WifiHud()
+        val six = base.copy(freqMhz = 6375, rxMbps = 2161)
+        assertEquals(2, hud.line(six, 0)?.role)
+        val late = hud.line(six, 30_000)
+        assertEquals(3, late?.role)
+        assertEquals("wi-fi ↓ 2161 Mb/s · no 320 MHz seen", late?.text)
+        assertEquals(null, hud.line(six.copy(freqMhz = 0), 31_000))
+    }
 }
